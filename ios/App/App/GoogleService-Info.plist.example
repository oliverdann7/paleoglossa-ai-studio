<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE — replace with the real GoogleService-Info.plist from Firebase Console:
  Firebase Console → Project Settings → General → Your apps → iOS app →
  Download GoogleService-Info.plist, then save it as ios/App/App/GoogleService-Info.plist
  (without the .example suffix). The real file is gitignored.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_ME_iOS_API_KEY</string>
	<key>BUNDLE_ID</key>
	<string>com.paleoglossa.app</string>
	<key>CLIENT_ID</key>
	<string>REPLACE_ME_CLIENT_ID.apps.googleusercontent.com</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_ME_SENDER_ID</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:REPLACE_ME_SENDER_ID:ios:REPLACE_ME_APP_HASH</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>PROJECT_ID</key>
	<string>paleoglossa-reader</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.REPLACE_ME_CLIENT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>paleoglossa-reader.appspot.com</string>
</dict>
</plist>
