rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DENY ALL BY DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // PUBLIC COLLECTIONS
    match /texts/{textId} {
      allow get, list: if true; // Everyone can read public texts
      allow write: if false;    // For now, only system can write to root texts
    }

    match /languages/{languageId} {
      allow get, list: if true;
    }

    match /lemmas/{lemmaId} {
      allow get, list: if true;
    }

    // USER-SPECIFIC DATA
    match /users/{userId} {
      allow get: if isOwner(userId);
      
      // Vocabulary
      match /vocabulary/{termId} {
        function isValidVocab(data) {
          return data.keys().hasAll(['term', 'status', 'languageId']) &&
                 data.term is string &&
                 data.status in ['NEW', 'SEEN', 'LEARNING', 'FAMILIAR', 'KNOWN', 'IGNORED'];
        }

        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidVocab(incoming());
        allow delete: if isOwner(userId);
      }

      // Imports
      match /imports/{importId} {
        function isValidImport(data) {
          return data.keys().hasAll(['title', 'languageId', 'sourceType', 'visibility']) &&
                 data.title is string &&
                 data.sourceType in ['paste', 'file', 'url', 'image', 'pdf'] &&
                 data.visibility in ['private', 'shared', 'public'];
        }

        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidImport(incoming());
        allow delete: if isOwner(userId);
      }

      // Reading Progress
      match /readingProgress/{textId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().textId == textId;
        allow delete: if isOwner(userId);
      }

      // Settings
      match /settings/{settingsId} {
        allow read, write: if isOwner(userId);
      }

      // Review Logs
      match /reviewLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == userId;
      }
    }
  }
}
