rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════
    // DENY ALL BY DEFAULT
    // ═══════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Fields that must only be written by the server (Admin SDK / Stripe webhook).
    // Client writes to the user profile may not modify these fields.
    // selectedLanguageIds is NOT server-controlled — users may toggle languages
    // within their plan limits on the client side.
    function serverControlledFields() {
      return ['currentPlan', 'subscriptionStatus', 'stripeCustomerId',
              'stripeSubscriptionId', 'trialEnd',
              'subscriptionUpdatedAt'];
    }

    // Returns true if the incoming write touches any server-controlled field.
    function touchesServerControlled() {
      return incoming().diff(existing()).affectedKeys().hasAny(serverControlledFields());
    }

    // ═══════════════════════════════════════════════════════
    // PUBLIC COLLECTIONS
    // ═══════════════════════════════════════════════════════

    // Public texts — read by anyone if marked public, write by Admin SDK only.
    match /publicTexts/{textId} {
      allow get: if resource.data.visibility == 'public';
      allow list: if resource.data.visibility == 'public';
      allow write: if false; // Admin SDK bypasses rules; client writes are never allowed
    }

    // ═══════════════════════════════════════════════════════
    // USER-SPECIFIC DATA
    // ═══════════════════════════════════════════════════════

    match /users/{userId} {

      // ── Profile ────────────────────────────────────────
      // Owner can read their own profile.
      allow get: if isOwner(userId);

      // Owner may create their profile on sign-up.
      // Subscription fields are not allowed on create (server sets them).
      // The stats field is optional — SignUp does not include it, but AuthContext does.
      allow create: if isOwner(userId)
        && incoming().keys().hasAll(['email', 'displayName', 'createdAt'])
        && !incoming().keys().hasAny(serverControlledFields());

      // Owner may update profile, but NOT server-controlled subscription fields.
      allow update: if isOwner(userId)
        && !touchesServerControlled();

      // ── Vocabulary ─────────────────────────────────────
      match /vocabulary/{termId} {
        function isValidVocabularyPayload() {
          return incoming().keys().hasAny(['term', 'normalizedTerm', 'status', 'languageId'])
            && (!incoming().keys().hasAll(['status']) || incoming().status in
               ['NEW', 'SEEN', 'LEARNING', 'FAMILIAR', 'KNOWN', 'IGNORED']);
        }

        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVocabularyPayload();
        allow update: if isOwner(userId) && isValidVocabularyPayload();
        allow delete: if isOwner(userId);
      }

      // ── Imports ────────────────────────────────────────
      match /imports/{importId} {
        function isValidImportPayload() {
          return incoming().keys().hasAll(['title', 'languageId', 'sourceType', 'visibility'])
            && incoming().sourceType in ['paste', 'file', 'url', 'image', 'pdf']
            && incoming().visibility in ['private', 'shared', 'public'];
        }

        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidImportPayload();
        allow update: if isOwner(userId) && isValidImportPayload();
        allow delete: if isOwner(userId);
      }

      // ── Reading Progress ───────────────────────────────
      match /readingProgress/{textId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Settings ───────────────────────────────────────
      // Covers both settings/main and settings/activeLanguage etc.
      match /settings/{documentId=**} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Review Logs ────────────────────────────────────
      match /reviewLogs/{logId} {
        function isValidReviewLogPayload() {
          return incoming().keys().hasAll(['vocabItemId', 'rating', 'timestamp']);
        }

        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReviewLogPayload();
        // Logs are append-only — no update or delete from client.
        allow update, delete: if false;
      }

      // ── Language Stats ─────────────────────────────────
      match /languageStats/{languageId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Notes ──────────────────────────────────────────
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Notebooks ──────────────────────────────────────
      match /notebooks/{notebookId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Tutor Sessions ────────────────────────────────
      match /tutorSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId);
          allow read, write: if isOwner(userId);
        }
      }
    }

    // ── Syntax Annotations (top-level, server-managed) ──
    match /syntaxAnnotations/{annotationId} {
      allow read: if true;   // eslint-disable-line @firebase/security-rules/no-open-reads — public annotations intentional
      allow write: if false; // Admin SDK only
    }
  }
}
