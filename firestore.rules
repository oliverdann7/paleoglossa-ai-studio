rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════
    // DENY ALL BY DEFAULT
    // ═══════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Fields that must only be written by the server (Admin SDK / Stripe webhook).
    // Client writes to the user profile may not modify these fields.
    function serverControlledFields() {
      return ['currentPlan', 'subscriptionStatus', 'stripeCustomerId',
              'stripeSubscriptionId', 'selectedLanguageIds', 'trialEnd',
              'subscriptionUpdatedAt'];
    }

    // Returns true if the incoming write touches any server-controlled field.
    function touchesServerControlled() {
      return incoming().diff(existing()).affectedKeys().hasAny(serverControlledFields());
    }

    // ═══════════════════════════════════════════════════════
    // PUBLIC COLLECTIONS
    // ═══════════════════════════════════════════════════════

    // Public texts — read by anyone if marked public, write by Admin SDK only.
    match /publicTexts/{textId} {
      allow get: if resource.data.visibility == 'public';
      allow list: if resource.data.visibility == 'public';
      allow write: if false; // Admin SDK bypasses rules; client writes are never allowed
    }

    // Public profiles — read by anyone, written by server only.
    match /publicProfiles/{uid} {
      // eslint-disable-next-line @firebase/security-rules/no-open-reads -- intentionally public
      allow read: if true;
      allow write: if false; // Admin SDK only (account creation/update)
    }

    // Syntax annotations — read by anyone, written by server only.
    match /syntaxAnnotations/{annotationId} {
      // eslint-disable-next-line @firebase/security-rules/no-open-reads -- public read intentional, writes are Admin-SDK-only
      allow read: if true;
      allow write: if false; // Admin SDK only
    }

    // ═══════════════════════════════════════════════════════
    // COURSES  (all mutations via server / Admin SDK)
    // ═══════════════════════════════════════════════════════

    // A course is readable by authenticated users if it is public/open,
    // or if the requesting user is the owner.
    // Member-only private courses are fetched through the API (which uses Admin SDK),
    // so we deny direct client reads of private courses to prevent enumeration.
    match /courses/{courseId} {
      allow get: if isSignedIn() && (
        resource.data.isPublic == true ||
        resource.data.ownerId == request.auth.uid
      );
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow write: if false; // Admin SDK only

      // Members sub-collection: only the course owner may read the full list.
      // Students see their own membership record only.
      match /members/{memberId} {
        allow get: if isSignedIn() && (
          memberId == request.auth.uid ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid
        );
        allow list: if isSignedIn() &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid;
        allow write: if false; // Admin SDK only (join/leave go through API)
      }
    }

    // ═══════════════════════════════════════════════════════
    // TEXT DISCUSSIONS  (all mutations via server / Admin SDK)
    // ═══════════════════════════════════════════════════════

    match /textDiscussions/{discussionId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow write: if false; // Admin SDK only
      }
    }

    // ═══════════════════════════════════════════════════════
    // AI USAGE  (server-controlled quota tracking)
    // ═══════════════════════════════════════════════════════

    // aiUsage documents are read and written exclusively by the server.
    // Clients must not read or write these documents directly.
    match /aiUsage/{uid} {
      allow read, write: if false; // Admin SDK only
    }

    // ═══════════════════════════════════════════════════════
    // IMPORTED TEXTS  (legacy top-level collection)
    // ═══════════════════════════════════════════════════════

    // importedTexts/{uid}/texts is a legacy path used by account deletion.
    // Only the owner may read their imported texts. Writes are server-only
    // (the client imports through the API, not directly to Firestore).
    match /importedTexts/{uid} {
      allow read, write: if false; // document-level denied; see subcollection

      match /texts/{textId} {
        allow read: if isOwner(uid);
        allow write: if false; // Admin SDK only (API handles imports & deletion)
      }
    }

    // ═══════════════════════════════════════════════════════
    // USER-SPECIFIC DATA
    // ═══════════════════════════════════════════════════════

    match /users/{userId} {

      // ── Profile ────────────────────────────────────────
      // Owner can always read their own profile.
      // Any signed-in user can read a profile that has isPublic == true.
      allow get: if isOwner(userId) || (isSignedIn() && resource.data.isPublic == true);

      // Owner may create their profile on sign-up.
      // Subscription fields are not allowed on create (server sets them).
      allow create: if isOwner(userId)
        && incoming().keys().hasAll(['email', 'displayName', 'createdAt', 'stats'])
        && !incoming().keys().hasAny(serverControlledFields());

      // Owner may update profile, but NOT server-controlled subscription fields.
      allow update: if isOwner(userId)
        && !touchesServerControlled();

      // ── Vocabulary ─────────────────────────────────────
      match /vocabulary/{termId} {
        function isValidVocabularyPayload() {
          return incoming().keys().hasAny(['term', 'normalizedTerm', 'status', 'languageId'])
            && (!incoming().keys().has('status') || incoming().status in
               ['NEW', 'SEEN', 'LEARNING', 'FAMILIAR', 'KNOWN', 'IGNORED']);
        }

        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVocabularyPayload();
        allow update: if isOwner(userId) && isValidVocabularyPayload();
        allow delete: if isOwner(userId);
      }

      // ── Imports ────────────────────────────────────────
      match /imports/{importId} {
        function isValidImportPayload() {
          return incoming().keys().hasAll(['title', 'languageId', 'sourceType', 'visibility'])
            && incoming().sourceType in ['paste', 'file', 'url', 'image', 'pdf', 'tei']
            && incoming().visibility in ['private', 'shared', 'public'];
        }

        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidImportPayload();
        allow update: if isOwner(userId) && isValidImportPayload();
        allow delete: if isOwner(userId);
      }

      // ── Reading Progress ───────────────────────────────
      match /readingProgress/{textId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Settings ───────────────────────────────────────
      // Covers both settings/main and settings/activeLanguage etc.
      match /settings/{documentId=**} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Review Logs ────────────────────────────────────
      match /reviewLogs/{logId} {
        function isValidReviewLogPayload() {
          return incoming().keys().hasAll(['vocabItemId', 'rating', 'timestamp']);
        }

        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReviewLogPayload();
        // Logs are append-only — no update or delete from client.
        allow update, delete: if false;
      }

      // ── Language Stats ─────────────────────────────────
      match /languageStats/{languageId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Notes ──────────────────────────────────────────
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Notebooks ──────────────────────────────────────
      match /notebooks/{notebookId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Tutor Sessions ────────────────────────────────
      match /tutorSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId);
          allow read, write: if isOwner(userId);
        }
      }

      // ── Beginner Progress ─────────────────────────────
      // Per-language milestone flags tracked directly by the client SDK.
      match /beginnerProgress/{languageId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly([
            'scriptOpened', 'firstTextOpened', 'firstWordSaved',
            'firstReviewCompleted', 'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }

      // ── Grammar Mastery ────────────────────────────────
      // Per-concept SRS mastery records tracked directly by the client SDK.
      match /grammarMastery/{conceptId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly([
            'conceptId', 'tier', 'score', 'lastReviewedAt',
            'nextReviewAt', 'reviewCount', 'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }

      // ── Challenge Progress ────────────────────────────
      // Written by the server (API + Admin SDK), read by owner.
      match /challengeProgress/{challengeId} {
        allow get, list: if isOwner(userId);
        allow write: if false; // Admin SDK only (challenges API route)
      }

      // ── Pronunciation Recordings ──────────────────────
      // Written by the server (POST /api/audio/recordings, size-guarded).
      // Owner may read and delete via the API.
      match /recordings/{recordingId} {
        allow get, list: if isOwner(userId);
        allow write: if false; // Admin SDK only — enforces size + count caps
      }
    }
  }
}
