{
  "entities": {
    "VocabularyItem": {
      "title": "Vocabulary Item",
      "description": "User word knowledge record.",
      "type": "object",
      "properties": {
        "term": { "type": "string" },
        "normalizedTerm": { "type": "string" },
        "status": { "enum": ["NEW", "SEEN", "LEARNING", "FAMILIAR", "KNOWN", "IGNORED"] },
        "languageId": { "type": "string" },
        "nextReview": { "type": "string" },
        "interval": { "type": "number" },
        "ease": { "type": "number" },
        "step": { "type": "number" },
        "lastSeenAt": { "type": "string" }
      },
      "required": ["term", "status", "languageId"]
    },
    "ImportedText": {
      "title": "Imported Text",
      "description": "User custom imported or added content.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "languageId": { "type": "string" },
        "sourceType": { "enum": ["paste", "file", "url", "image", "pdf"] },
        "visibility": { "enum": ["private", "shared", "public"] }
      },
      "required": ["title", "languageId", "sourceType", "visibility"]
    },
    "ReadingProgress": {
      "title": "Reading Progress",
      "description": "Progress marker within a text.",
      "type": "object",
      "properties": {
        "textId": { "type": "string" },
        "lastPosition": { "type": "number" },
        "sentenceIndex": { "type": "number" }
      },
      "required": ["textId", "lastPosition"]
    },
    "ReviewLog": {
      "title": "Review Log",
      "description": "History of a word review action.",
      "type": "object",
      "properties": {
        "vocabItemId": { "type": "string" },
        "quality": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["vocabItemId", "quality", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}/vocabulary/{termId}": {
      "schema": { "$ref": "#/entities/VocabularyItem" },
      "description": "User personal dictionary."
    },
    "users/{userId}/imports/{importId}": {
      "schema": { "$ref": "#/entities/ImportedText" },
      "description": "User custom imported texts."
    },
    "users/{userId}/readingProgress/{textId}": {
      "schema": { "$ref": "#/entities/ReadingProgress" },
      "description": "Progress within a text."
    },
    "users/{userId}/reviewLogs/{logId}": {
      "schema": { "$ref": "#/entities/ReviewLog" },
      "description": "History of SRS reviews."
    },
    "texts/{textId}": {
      "schema": { "$ref": "#/entities/ImportedText" },
      "description": "Public shared texts."
    },
    "lemmas/{lemmaId}": {
      "schema": "object",
      "description": "Universal lemma mapping."
    }
  }
}
