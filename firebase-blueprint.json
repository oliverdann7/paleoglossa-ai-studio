{
  "entities": {
    "VocabularyItem": {
      "title": "Vocabulary Item",
      "description": "User word knowledge record with SRS data.",
      "type": "object",
      "properties": {
        "term": { "type": "string" },
        "normalizedTerm": { "type": "string" },
        "status": { "enum": ["NEW", "SEEN", "LEARNING", "FAMILIAR", "KNOWN", "IGNORED"] },
        "languageId": { "type": "string" },
        "nextReview": { "type": "string" },
        "interval": { "type": "number" },
        "ease": { "type": "number" },
        "step": { "type": "number" },
        "lastReviewed": { "type": "string" },
        "lastSeenAt": { "type": "string" },
        "encounterCount": { "type": "number" },
        "userGloss": { "type": "string" },
        "notes": { "type": "string" },
        "contexts": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["term", "status", "languageId"]
    },
    "ImportedText": {
      "title": "Imported Text",
      "description": "User custom imported or added content.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "languageId": { "type": "string" },
        "sourceType": { "enum": ["paste", "file", "url", "image", "pdf"] },
        "visibility": { "enum": ["private", "shared", "public"] }
      },
      "required": ["title", "languageId", "sourceType", "visibility"]
    },
    "ReadingProgress": {
      "title": "Reading Progress",
      "description": "Progress marker within a text.",
      "type": "object",
      "properties": {
        "textId": { "type": "string" },
        "lastPosition": { "type": "number" },
        "sentenceIndex": { "type": "number" }
      },
      "required": ["textId", "lastPosition"]
    },
    "ReviewLog": {
      "title": "Review Log",
      "description": "History of a word review action including SRS delta.",
      "type": "object",
      "properties": {
        "vocabItemId": { "type": "string" },
        "term": { "type": "string" },
        "rating": { "type": "string" },
        "responseMs": { "type": "number" },
        "intervalBefore": { "type": "number" },
        "intervalAfter": { "type": "number" },
        "easeBefore": { "type": "number" },
        "easeAfter": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["vocabItemId", "rating", "timestamp"]
    },
    "BeginnerProgress": {
      "title": "Beginner Progress",
      "description": "Per-language milestone progress for the Beginner Hub.",
      "type": "object",
      "properties": {
        "scriptOpened": { "type": "boolean" },
        "firstTextOpened": { "type": "boolean" },
        "firstWordSaved": { "type": "boolean" },
        "firstReviewCompleted": { "type": "boolean" },
        "updatedAt": { "type": "string", "description": "serverTimestamp" }
      }
    }
  },
  "firestore": {
    "users/{userId}/vocabulary/{termId}": {
      "schema": { "$ref": "#/entities/VocabularyItem" },
      "description": "User personal dictionary."
    },
    "users/{userId}/imports/{importId}": {
      "schema": { "$ref": "#/entities/ImportedText" },
      "description": "User custom imported texts."
    },
    "users/{userId}/readingProgress/{textId}": {
      "schema": { "$ref": "#/entities/ReadingProgress" },
      "description": "Progress within a text."
    },
    "users/{userId}/reviewLogs/{logId}": {
      "schema": { "$ref": "#/entities/ReviewLog" },
      "description": "History of SRS reviews."
    },
    "users/{userId}/beginnerProgress/{languageId}": {
      "schema": { "$ref": "#/entities/BeginnerProgress" },
      "description": "Per-language beginner-hub milestone state."
    },
    "texts/{textId}": {
      "schema": { "$ref": "#/entities/ImportedText" },
      "description": "Public shared texts."
    },
    "lemmas/{lemmaId}": {
      "schema": "object",
      "description": "Universal lemma mapping."
    }
  }
}
