# ═══════════════════════════════════════════════════════════════
# FIREBASE CLIENT CONFIG
# ═══════════════════════════════════════════════════════════════
# For local dev: copy this section's values into firebase-applet-config.json.
#   The app reads firebase-applet-config.json first, then falls back to VITE_* env vars.
#
# On Vercel: set these as VITE_FIREBASE_* environment variables.
#
# Variables marked REQUIRED are needed for Firebase SDK initialization.
# Variables marked OPTIONAL may be left empty in development.

VITE_FIREBASE_PROJECT_ID=paleoglossa-reader          # REQUIRED
VITE_FIREBASE_APP_ID=REDACTED_FIREBASE_APP_ID  # REQUIRED
VITE_FIREBASE_API_KEY=REDACTED_FIREBASE_API_KEY # REQUIRED
VITE_FIREBASE_AUTH_DOMAIN=paleoglossa-reader.firebaseapp.com    # REQUIRED
VITE_FIREBASE_STORAGE_BUCKET=paleoglossa-reader.firebasestorage.app  # OPTIONAL
VITE_FIREBASE_MESSAGING_SENDER_ID=REDACTED_SENDER_ID               # OPTIONAL
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)                # OPTIONAL

# ═══════════════════════════════════════════════════════════════
# FIREBASE ADMIN SDK (server-side only, api/ routes)
# ═══════════════════════════════════════════════════════════════
# These are NEVER sent to the browser. They are only used by api/_lib/firebaseAdmin.ts
# which runs on the server (Vercel serverless functions / local tsx dev server).
#
# Preferred: paste the full service account JSON (from Firebase Console > Project Settings > Service Accounts)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"paleoglossa-reader",...}
#
# Alternatively, set these three individually:
# FIREBASE_PROJECT_ID=paleoglossa-reader
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@paleoglossa-reader.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Falls back to Application Default Credentials (ADC) if FIREBASE_PROJECT_ID is set
# and no service account env vars are provided.

# ═══════════════════════════════════════════════════════════════
# STRIPE (set on Vercel for production)
# ═══════════════════════════════════════════════════════════════
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BASIC_PRICE_ID=REDACTED_STRIPE_PRICE_ID
# STRIPE_BASIC_YEARLY_PRICE_ID=REDACTED_STRIPE_PRICE_ID
# STRIPE_DUO_PRICE_ID=REDACTED_STRIPE_PRICE_ID
# STRIPE_DUO_YEARLY_PRICE_ID=REDACTED_STRIPE_PRICE_ID
# STRIPE_FULL_PRICE_ID=REDACTED_STRIPE_PRICE_ID
# STRIPE_FULL_YEARLY_PRICE_ID=REDACTED_STRIPE_PRICE_ID

# ═══════════════════════════════════════════════════════════════
# GEMINI AI
# ═══════════════════════════════════════════════════════════════
# GEMINI_API_KEY=...

# ═══════════════════════════════════════════════════════════════
# POSTHOG (optional — product analytics)
# ═══════════════════════════════════════════════════════════════
# Get your API key from posthog.com → Project Settings → Project API Key.
# If unset, PostHog is silently disabled (safe for local dev).
# In dev mode, PostHog auto-opt-outs capturing.
# VITE_POSTHOG_API_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ═══════════════════════════════════════════════════════════════
# SENTRY (optional — error monitoring)
# ═══════════════════════════════════════════════════════════════
# Get your DSN from sentry.io → Project Settings → Client Keys.
# If unset, Sentry is silently disabled (safe for local dev).
# VITE_SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# ═══════════════════════════════════════════════════════════════
# API BASE URL (required for Capacitor native builds)
# ═══════════════════════════════════════════════════════════════
# For normal web / Vercel deployments this can be left empty — relative
# /api/… routes resolve against the same origin automatically.
#
# For Capacitor iOS/Android native builds the WebView origin is not the
# production backend, so you MUST set this to the production API origin:
#
#   VITE_API_BASE_URL=https://paleoglossa.com
#
# If unset, all API calls use relative paths (default web behaviour).
# VITE_API_BASE_URL=https://paleoglossa.com

# ═══════════════════════════════════════════════════════════════
# MOBILE PURCHASES (Native App Compliance)
# ═══════════════════════════════════════════════════════════════
# Set to 'true' to enable in-app purchases for mobile.
# Defaults to 'false' (Stripe checkout disabled in native).
# VITE_ENABLE_MOBILE_PURCHASES=false

# ═══════════════════════════════════════════════════════════════
# COMMUNITY FEATURES (Mobile Release)
# ═══════════════════════════════════════════════════════════════
# Set to 'true' to enable community/social features.
# Defaults to 'false' in native builds (not yet moderation-ready).
# VITE_ENABLE_COMMUNITY=false

# ═══════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT REQUIREMENTS
# ═══════════════════════════════════════════════════════════════
# The following env vars must be set in production for the app to function:
#
# Core:
#   VITE_FIREBASE_PROJECT_ID
#   VITE_FIREBASE_APP_ID
#   VITE_FIREBASE_API_KEY
#   VITE_FIREBASE_AUTH_DOMAIN
#
# Admin SDK (server-side):
#   FIREBASE_SERVICE_ACCOUNT_JSON (or individual FIREBASE_* vars)
#
# Optional by feature:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_BASIC_PRICE_ID, STRIPE_BASIC_YEARLY_PRICE_ID,
#   STRIPE_DUO_PRICE_ID, STRIPE_DUO_YEARLY_PRICE_ID, STRIPE_FULL_PRICE_ID, STRIPE_FULL_YEARLY_PRICE_ID — payments
#   GEMINI_API_KEY — AI analysis, tutor, pronunciation
#   GOOGLE_TTS_API_KEY — Text-to-speech audio
#   VITE_SENTRY_DSN — error monitoring (sentry.io)
#   VITE_POSTHOG_API_KEY — product analytics (posthog.com)
#   VITE_POSTHOG_HOST — custom PostHog host (default: https://eu.i.posthog.com)
