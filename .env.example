# Firebase Client Config (for local dev — copy to firebase-applet-config.json)
# On Vercel, these are set as VITE_FIREBASE_* env vars
VITE_FIREBASE_PROJECT_ID=paleoglossa-reader
VITE_FIREBASE_APP_ID=REDACTED_FIREBASE_APP_ID
VITE_FIREBASE_API_KEY=REDACTED_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=paleoglossa-reader.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=paleoglossa-reader.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REDACTED_SENDER_ID
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Firebase Admin SDK (server-side, for api/* routes)
# Preferred: paste the full service account JSON (from Firebase Console > Project Settings > Service Accounts)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"paleoglossa-reader",...}
#
# Alternatively, set these three individually:
# FIREBASE_PROJECT_ID=paleoglossa-reader
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@paleoglossa-reader.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Falls back to Application Default Credentials (ADC) if FIREBASE_PROJECT_ID is set
# and no service account env vars are provided.

# Stripe (set on Vercel for production)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BASIC_PRICE_ID=price_...
# STRIPE_DUO_PRICE_ID=price_...
# STRIPE_FULL_PRICE_ID=price_...

# Gemini AI
# GEMINI_API_KEY=...
