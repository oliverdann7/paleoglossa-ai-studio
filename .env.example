# ═══════════════════════════════════════════════════════════════
# FIREBASE CLIENT CONFIG
# ═══════════════════════════════════════════════════════════════
# For local dev: copy this section's values into firebase-applet-config.json.
#   The app reads firebase-applet-config.json first, then falls back to VITE_* env vars.
#
# On Vercel: set these as VITE_FIREBASE_* environment variables.
#
# Variables marked REQUIRED are needed for Firebase SDK initialization.
# Variables marked OPTIONAL may be left empty in development.

VITE_FIREBASE_PROJECT_ID=paleoglossa-reader          # REQUIRED
VITE_FIREBASE_APP_ID=REDACTED_FIREBASE_APP_ID  # REQUIRED
VITE_FIREBASE_API_KEY=REDACTED_FIREBASE_API_KEY # REQUIRED
VITE_FIREBASE_AUTH_DOMAIN=paleoglossa-reader.firebaseapp.com    # REQUIRED
VITE_FIREBASE_STORAGE_BUCKET=paleoglossa-reader.firebasestorage.app  # OPTIONAL
VITE_FIREBASE_MESSAGING_SENDER_ID=REDACTED_SENDER_ID               # OPTIONAL
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)                # OPTIONAL

# ═══════════════════════════════════════════════════════════════
# FIREBASE ADMIN SDK (server-side only, api/ routes)
# ═══════════════════════════════════════════════════════════════
# These are NEVER sent to the browser. They are only used by api/_lib/firebaseAdmin.ts
# which runs on the server (Vercel serverless functions / local tsx dev server).
#
# Preferred: paste the full service account JSON (from Firebase Console > Project Settings > Service Accounts)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"paleoglossa-reader",...}
#
# Alternatively, set these three individually:
# FIREBASE_PROJECT_ID=paleoglossa-reader
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@paleoglossa-reader.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Falls back to Application Default Credentials (ADC) if FIREBASE_PROJECT_ID is set
# and no service account env vars are provided.

# ═══════════════════════════════════════════════════════════════
# STRIPE (set on Vercel for production)
# ═══════════════════════════════════════════════════════════════
# Required for payments. Without these, subscription purchases will fail.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BASIC_PRICE_ID=price_...
# STRIPE_DUO_PRICE_ID=price_...
# STRIPE_FULL_PRICE_ID=price_...

# ═══════════════════════════════════════════════════════════════
# GEMINI AI
# ═══════════════════════════════════════════════════════════════
# Required for AI analysis, pronunciation guides, and tutor features.
# Without this, AI endpoints will return fallback/basic results.
# GEMINI_API_KEY=...

# ═══════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT REQUIREMENTS
# ═══════════════════════════════════════════════════════════════
# The following env vars must be set in production for the app to function:
#
# Core:
#   VITE_FIREBASE_PROJECT_ID
#   VITE_FIREBASE_APP_ID
#   VITE_FIREBASE_API_KEY
#   VITE_FIREBASE_AUTH_DOMAIN
#
# Admin SDK (server-side):
#   FIREBASE_SERVICE_ACCOUNT_JSON (or individual FIREBASE_* vars)
#
# Optional by feature:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_*_PRICE_ID — payments
#   GEMINI_API_KEY — AI analysis, tutor, pronunciation
#   GOOGLE_TTS_API_KEY — Text-to-speech audio
