# ═══════════════════════════════════════════════════════════════
# NATIVE APP PRODUCTION ENVIRONMENT
# ═══════════════════════════════════════════════════════════════
# Copy this to .env.native-production and fill in the values before
# building native iOS/Android bundles for TestFlight / Play Store.
#
# The filename MUST be exactly `.env.native-production` — that is the file
# Vite loads for `--mode native-production` (run via `npm run ios:sync:production`
# or `npm run android:sync:production`). Any other name (e.g. `.env.production.native`)
# is silently ignored, leaving Firebase/API config empty and the native app
# stuck on a blank "Loading…" screen.

# Required: API base URL for native builds
VITE_API_BASE_URL=https://paleoglossa.com

# Required: Set Firebase client config (copy from .env.example)
VITE_FIREBASE_PROJECT_ID=paleoglossa-reader
VITE_FIREBASE_APP_ID=1:261153472610:web:11225ffcdb1cf653c6913b
VITE_FIREBASE_API_KEY=AIzaSyDGrwoZigzVArHlCQNPs5N-IdxmD61tM5k
VITE_FIREBASE_AUTH_DOMAIN=paleoglossa-reader.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=paleoglossa-reader.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=261153472610

# Native Google Sign-In (iOS): OAuth client id of the *iOS* app in the
# paleoglossa-reader Firebase project (Firebase Console -> Project Settings ->
# Your apps -> iOS -> GoogleService-Info.plist -> CLIENT_ID). Public config --
# it ships inside the app bundle by design. When empty, the Google button is
# hidden on native and only Apple + email sign-in are offered.
# The build also needs the reversed id as an Info.plist URL scheme -- this is
# injected automatically by scripts/ios-google-scheme.sh (run by cap sync
# scripts and ci_post_clone.sh).
VITE_GOOGLE_IOS_CLIENT_ID=

# Mobile purchase compliance: Stripe checkout disabled in native builds
VITE_ENABLE_MOBILE_PURCHASES=false

# Community features: disabled by default until moderation/reporting is verified
VITE_ENABLE_COMMUNITY=false
